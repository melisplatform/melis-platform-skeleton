{
	"name": "melisplatform/melis-platform-skeleton",
	"description": "Melis Platform Skeleton",
	"type": "project",
	"license": "OSL-3.0",
	"support": {
		"docs": "https://melisplatform.github.io/docs/"
	},
	"authors": [
		{
			"name": "Melis Technology",
			"email": "contact@melistechnology.com",
			"homepage": "https://www.melisplatform.com/",
			"role": "Developer"
		}
	],
	"keywords": [
		"melis",
		"melisplatform",
		"platform",
		"laminas",
		"mvc",
		"framework"
	],	
	"require": {
		"php": "^8.1|^8.3|^8.4|^8.5",
		"melisplatform/melis-asset-manager": "^6.0",
		"melisplatform/melis-composerdeploy": "^6.0",
		"melisplatform/melis-core": "^6.0",
		"melisplatform/melis-dbdeploy": "^6.0",
		"melisplatform/melis-installer": "^6.0",
		"melisplatform/melis-marketplace": "^6.0",
		"melisplatform/laminas-mail": "^2.25",
		"melisplatform/laminas-mime": "^2.12",
		"melisplatform/laminas-crypt": "^3.13",
		"melisplatform/laminas-file": "^2.13"
	},
	"scripts": {
		"post-update-cmd": [
			"MelisCore\\ModuleComposerScript::executeScripts",
			"MelisDbDeploy\\DbDeployOnComposerUpdate::postUpdate"
		],
		"development-disable": "laminas-development-mode disable",
		"development-enable": "laminas-development-mode enable",
		"development-status": "laminas-development-mode status"
	},
	"config": {
		"platform-check": false,
		"allow-plugins": {
			"symfony/flex": false,
			"symfony/runtime": true
		},
		"platform": {
			"php": "8.3.0"
		}
	}
}
