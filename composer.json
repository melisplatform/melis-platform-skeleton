{
	"name": "melisplatform/melis-platform-skeleton",
	"description": "Melis Platform Skeleton",
	"type": "project",
	"license": "OSL-3.0",
	"keywords": [
		"melis",
		"melisplatform",
		"platform",
		"zf2",
		"laminas",
		"mvc",
		"framework"
	],	
	"require": {
		"php": "^8.1|^8.3|^8.4|^8.5",
		"melisplatform/melis-asset-manager": "^5.3",
		"melisplatform/melis-composerdeploy": "^5.3.3",
		"melisplatform/melis-core": "^5.3.31",
		"melisplatform/melis-dbdeploy": "^5.3",
		"melisplatform/melis-installer": "^5.3.3",
		"melisplatform/melis-marketplace": "^5.3",
		"melisplatform/laminas-mail": "^2.25",
		"melisplatform/laminas-mime": "^2.12",
		"melisplatform/laminas-crypt": "^3.13",
		"melisplatform/laminas-file": "^2.13"
	},
	"scripts": {
		"post-update-cmd": [
			"MelisCore\\ModuleComposerScript::executeScripts",
			"MelisDbDeploy\\DbDeployOnComposerUpdate::postUpdate"
		],
		"development-disable": "laminas-development-mode disable",
		"development-enable": "laminas-development-mode enable",
		"development-status": "laminas-development-mode status"
	},
	"config": {
		"platform-check": false,
		"allow-plugins": {
			"symfony/flex": false,
			"symfony/runtime": true
		},
		"platform": {
			"php": "8.3.0"
		}
	}
}
